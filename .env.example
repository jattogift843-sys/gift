# Copy to .env and adjust
PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database (Supabase Postgres) ----
# Supabase dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL : "Transaction" pooler connection (host ...pooler.supabase.com:6543) — used by the app
# DIRECT_URL   : "Direct connection" (db.<ref>.supabase.co:5432) — used by drizzle-kit for migrations
# Append ?sslmode=require to both.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
ACCRUAL_INTERVAL_MINUTES=60
ROBOT_TICK_MINUTES=1
# Email alerts: set SMTP_* to send real mail; leave SMTP_HOST blank to log to the admin Email Log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MT5 Smart Market <no-reply@mt5smartmarket.com>
ADMIN_EMAIL=admin@mt5smartmarket.com
ADMIN_PASSWORD=Admin@12345
# a single pre-approved member account, seeded for convenience
MEMBER_EMAIL=member@mt5smartmarket.com
MEMBER_PASSWORD=Member@12345

# Cross-origin: comma-separated browser origins allowed to call the API.
# Only needed if a frontend bundle is hosted on a different domain than this API.
# CORS_ORIGINS=https://example.com,https://app.example.com
